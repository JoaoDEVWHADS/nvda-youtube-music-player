msgstr "トラックリピート: オン"

msgid "Repetir Faixa: Desligado"
msgstr "トラックリピート: オフ"

msgid "Erro ao carregar áudio"
msgstr "オーディオ読み込みエラー"

msgid "Tocando próxima..."
msgstr "次を再生中..."

msgid "Fim da lista"
msgstr "リストの最後"

msgid "Reproduzindo"
msgstr "再生中"

msgid "Pausado"
msgstr "一時停止中"

msgid "Volume: {}% | Velocidade: {}x | Tom: {}"
msgstr "音量: {}% | 速度: {}x | ピッチ: {}"

msgid "Volume: {}%"
msgstr "音量: {}%"

msgid "Velocidade: {}x"
msgstr "速度: {}x"

msgid "Tom: {}"
msgstr "ピッチ: {}"

msgid "Vel+Tom: {}x / {} semitons"
msgstr "速度+ピッチ: {}x / {} 半音"

msgid "Avançou {} segundos"
msgstr "{} 秒進みました"

msgid "Retrocedeu {} segundos"
msgstr "{} 秒戻りました"

msgid "&Continuar"
msgstr "再開(&R)"

msgid "Carregando próxima..."
msgstr "次を読み込み中..."

msgid "Sem próxima faixa"
msgstr "次のトラックはありません"

msgid "Reiniciando música"
msgstr "トラックを再起動"

msgid "Voltando para anterior..."
msgstr "前に戻る..."

msgid "Início da lista"
msgstr "リストの先頭"

msgid "Nenhum dispositivo encontrado"
msgstr "デバイスが見つかりません"

msgid "Escolha o dispositivo de saída:"
msgstr "出力デバイスを選択:"

msgid "Dispositivo de Áudio"
msgstr "オーディオデバイス"

msgid "Dispositivo alterado para: {}"
msgstr "デバイスが変更されました: {}"

msgid "Auto-Play Habilitado"
msgstr "自動再生が有効"

msgid "Auto-Play Desabilitado"
msgstr "自動再生が無効"

msgid "Autenticação (Opcional)"
msgstr "認証 (オプション)"

msgid "Arquivo de cookies (cookies.txt - formato Netscape):"
msgstr "Cookie ファイル (cookies.txt - Netscape 形式):"

msgid "Procurar..."
msgstr "参照..."

msgid "Dica: Utilize extensões como 'Get cookies.txt LOCALLY' para exportar cookies do navegador. Isso ajuda a contornar bloqueios regionais do YouTube."
msgstr "ヒント: ブラウザの Cookie をエクスポートするには 'Get cookies.txt LOCALLY' などの拡張機能を使用してください。これにより、YouTube の地域制限を回避できます。"

msgid "Selecione o arquivo de cookies"
msgstr "Cookie ファイルを選択"

msgid "O arquivo de cookies especificado não existe."
msgstr "指定された Cookie ファイルは存在しません。"

msgid "Erro"
msgstr "エラー"

msgid "Aguarde, já está carregando..."
msgstr "お待ちください、読み込み中です..."

msgid "Abre o YouTube Music Player"
msgstr "YouTube Music Playerを開く"

msgid "Update Available - YouTube Music Player"
msgstr "更新が利用可能です - YouTube Music Player"

msgid "A new version of YouTube Music Player is available!\n"
"\n"
"Current version: {current}\n"
"New version: {new}\n"
"\n"
"Click 'Download and Install' to update automatically."
msgstr "YouTube Music Playerの新バージョンが利用可能です！\n"
"\n"
"現在のバージョン: {current}\n"
"新しいバージョン: {new}\n"
"\n"
"「ダウンロードしてインストール」をクリックすると自動的に更新されます。"

msgid "Release: {}"
msgstr "リリース: {}"

msgid "&Download and Install"
msgstr "ダウンロードしてインストール(&D)"

msgid "&Close"
msgstr "閉じる(&C)"

msgid "Downloading update... Please wait."
msgstr "更新をダウンロードしています... しばらくお待ちください。"

msgid "Error: Failed to download update"
msgstr "エラー: 更新のダウンロードに失敗しました"

msgid "Error: Failed to install update"
msgstr "エラー: 更新のインストールに失敗しました"

msgid "Error: Update failed. Check NVDA log for details."
msgstr "エラー: 更新に失敗しました。詳細はNVDAログを確認してください。"

msgid "Update installed successfully! NVDA needs to restart."
msgstr "更新が正常にインストールされました！NVDAを再起動する必要があります。"

msgid "YouTube Music Player has been updated to version {version}.\n"
"\n"
"NVDA must be restarted for the update to take effect.\n"
"\n"
"Restart NVDA now?"
msgstr "YouTube Music Playerはバージョン {version} に更新されました。\n"
"\n"
"更新を有効にするにはNVDAを再起動する必要があります。\n"
"\n"
"今すぐNVDAを再起動しますか？"

msgid "Update Installed"
msgstr "更新インストール完了"

msgid "Update failed because files are in use.\n"
"\n"
"Please RESTART NVDA and try updating immediately,\n"
"\n"
"WITHOUT opening the add-on settings."
msgstr "ファイルが使用中のため、更新に失敗しました。\n"
"\n"
"NVDAを再起動し、アドオン設定を開かずに\n"
"\n"
"すぐに更新を試してください。"

msgid "Update Failed - Files Locked"
msgstr "更新失敗 - ファイルロック"
