msgstr "自動再生を無効化(&D)"

msgid "&Habilitar Auto-Play"
msgstr "自動再生を有効化(&E)"

msgid "&Repetir: Ligado"
msgstr "リピート: オン(&R)"

msgid "&Repetir: Desligado"
msgstr "リピート: オフ(&R)"

